# Supabase project connection (public/browser-safe values only).
# Copy this file to .env.local and fill in real values for local development.
# Never commit .env, .env.local, .env.production, or any file containing a
# service-role key, database password, or other secret.

# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Publishable / anon key. This key is safe to expose to the browser by design
# (Row Level Security is what actually protects data) — it is NOT the
# service-role key and must never be confused with it.
VITE_SUPABASE_ANON_KEY=

# Phase 2 personal-photo try-on (unused in Phase 1). Server-only — never prefix with VITE_.
# TRYON_API_KEY=
# TRYON_PROVIDER=fal
# TRYON_MODEL_URL=https://fal.run/fal-ai/cat-vton

# ─────────────────────────────────────────────────────────────────────────────
# Razorpay payment integration.
# ─────────────────────────────────────────────────────────────────────────────
# STEP 1 — Get these from https://dashboard.razorpay.com → Settings → API Keys
#   • Use TEST keys while developing; switch to LIVE keys for production.
#   • Key ID is the publishable identifier (safe to include in the browser).
#   • Key Secret is server-only — NEVER prefix with VITE_ and NEVER commit it.

# Browser-safe publishable key (Razorpay Key ID). Set this to enable the
# Razorpay checkout button. Leave blank to show "Payment unavailable" UI.
VITE_RAZORPAY_KEY_ID=

# ─── SERVER-ONLY (Supabase Edge Function secrets) ─────────────────────────────
# Set the following via the Supabase Dashboard:
#   Project → Edge Functions → Manage secrets
# or via the Supabase CLI:
#   supabase secrets set RAZORPAY_KEY_SECRET=rzp_test_xxxx
#   supabase secrets set RAZORPAY_WEBHOOK_SECRET=whsec_xxxx
#
# RAZORPAY_KEY_SECRET=        ← Razorpay Key Secret (from Dashboard → API Keys)
# RAZORPAY_WEBHOOK_SECRET=    ← Webhook signing secret (Dashboard → Webhooks → Secret)
#
# STEP 2 — Create Razorpay Plans for each billable tier/interval before going live.
#   Dashboard → Subscriptions → Plans → Create Plan
#   Then update billing_provider_plan_instances table with the returned plan_id values.
#
# STEP 3 — Register the webhook URL in Razorpay Dashboard → Webhooks:
#   URL: https://<your-supabase-project>.supabase.co/functions/v1/razorpay-webhook
#   Events to subscribe: subscription.activated, subscription.charged,
#                        subscription.halted, subscription.cancelled,
#                        subscription.completed, subscription.updated,
#                        payment.captured, payment.failed
#
# STEP 4 — Apply the latest Supabase migration before accepting payments:
#   supabase db push (remote) or supabase migration up (local)
#   This creates billing_invoices, begin_mock_subscription, confirm_mock_subscription RPCs.
# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────────────────
# Mock payment mode (local dev + Vercel Preview only).
# ─────────────────────────────────────────────────────────────────────────────
# Enables the mock payment gateway so you can test the full subscription
# lifecycle without Razorpay credentials or real charges.
#
# ENVIRONMENT GUIDE:
#   ┌─────────────────┬──────────────────────────────────────────────────┐
#   │ Local dev       │ Set to "true" in .env.local (never committed)    │
#   │ Vercel Preview  │ Set to "true" in Vercel → Settings → Env Vars   │
#   │                 │ → Preview only (do NOT check Production)         │
#   │ Vercel Prod     │ Leave blank / do not set — mock disabled         │
#   └─────────────────┴──────────────────────────────────────────────────┘
#
# SAFETY:
#   - If not set (or empty), mock mode is disabled and the button hidden.
#   - Server-side RPCs (begin_mock_subscription, confirm_mock_subscription)
#     are protected by Supabase authentication and row-level security.
#   - No real payment details are ever collected in mock mode.
#   - Subscriptions are activated server-side only via authenticated RPCs.
#
# HOW TO USE (local):
#   1. Copy this file to .env.local
#   2. Set VITE_MOCK_PAYMENTS=true
#   3. Run: supabase db push  (applies mock_payment_rpcs migration)
#   4. Start: npm run dev
#   5. Navigate to /pricing → choose a paid plan → checkout
#   6. The checkout shows an amber "Mock Payment Mode" banner + button
#   7. Click "Simulate Successful Payment" to activate your test membership
#   8. Check /billing — invoice is labeled MOCK / TEST MODE
#
# HOW TO USE (Vercel Preview):
#   1. Vercel Dashboard → Project → Settings → Environment Variables
#   2. Add VITE_MOCK_PAYMENTS = true
#   3. Under "Environment", check Preview ONLY (not Production)
#   4. Redeploy the Preview branch to pick up the new variable
VITE_MOCK_PAYMENTS=
# ─────────────────────────────────────────────────────────────────────────────
