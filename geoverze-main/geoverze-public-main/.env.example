# Supabase project connection (public/browser-safe values only).
# Copy this file to .env.local and fill in real values for local development.
# Never commit .env, .env.local, .env.production, or any file containing a
# service-role key, database password, or other secret.

# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Publishable / anon key. This key is safe to expose to the browser by design
# (Row Level Security is what actually protects data) — it is NOT the
# service-role key and must never be confused with it.
VITE_SUPABASE_ANON_KEY=

# Phase 2 personal-photo try-on (unused in Phase 1). Server-only — never prefix with VITE_.
# TRYON_API_KEY=
# TRYON_PROVIDER=fal
# TRYON_MODEL_URL=https://fal.run/fal-ai/cat-vton

# ─────────────────────────────────────────────────────────────────────────────
# Razorpay payment integration.
# ─────────────────────────────────────────────────────────────────────────────
# STEP 1 — Get these from https://dashboard.razorpay.com → Settings → API Keys
#   • Use TEST keys while developing; switch to LIVE keys for production.
#   • Key ID is the publishable identifier (safe to include in the browser).
#   • Key Secret is server-only — NEVER prefix with VITE_ and NEVER commit it.

# Browser-safe publishable key (Razorpay Key ID). Set this to enable the
# Razorpay checkout button. Leave blank to show "Payment unavailable" UI.
VITE_RAZORPAY_KEY_ID=

# ─── SERVER-ONLY (Supabase Edge Function secrets) ─────────────────────────────
# Set the following via the Supabase Dashboard:
#   Project → Edge Functions → Manage secrets
# or via the Supabase CLI:
#   supabase secrets set RAZORPAY_KEY_SECRET=rzp_test_xxxx
#   supabase secrets set RAZORPAY_WEBHOOK_SECRET=whsec_xxxx
#
# RAZORPAY_KEY_SECRET=        ← Razorpay Key Secret (from Dashboard → API Keys)
# RAZORPAY_WEBHOOK_SECRET=    ← Webhook signing secret (Dashboard → Webhooks → Secret)
#
# STEP 2 — Create Razorpay Plans for each billable tier/interval before going live.
#   Dashboard → Subscriptions → Plans → Create Plan
#   Then update billing_provider_plan_instances table with the returned plan_id values.
#
# STEP 3 — Register the webhook URL in Razorpay Dashboard → Webhooks:
#   URL: https://<your-supabase-project>.supabase.co/functions/v1/razorpay-webhook
#   Events to subscribe: subscription.activated, subscription.charged,
#                        subscription.halted, subscription.cancelled,
#                        subscription.completed, subscription.updated,
#                        payment.captured, payment.failed
#
# STEP 4 — Apply the latest Supabase migration before accepting payments:
#   supabase db push (remote) or supabase migration up (local)
# ─────────────────────────────────────────────────────────────────────────────


# =============================================================================
# MOCK PAYMENT MODE — authorized subscription testing
# =============================================================================
#
# Enables the mock payment gateway so you can test the full subscription
# lifecycle without Razorpay credentials or real charges.
#
# HOW IT WORKS:
#   • VITE_MOCK_PAYMENTS is read at REQUEST TIME by a server function
#     (getPaymentConfig / beginMockPaymentFn / confirmMockPaymentFn).
#     Changing this variable in Vercel takes effect on the NEXT request —
#     no rebuild or redeploy required.
#   • When enabled the checkout shows a "TEST MODE — NO REAL PAYMENTS"
#     banner, an amber "Mock Payment Mode" indicator, and a mock checkout
#     button (Razorpay button is hidden while mock mode is on).
#   • Mock subscriptions are recorded with is_mock=true and can be
#     filtered out of production billing reports at any time.
#   • Credits granted are real wallet credits, configured per plan:
#       Basic → 5 credits/month
#       Pro   → 20 credits/month
#       Advance → 50 credits/month
#
# SECURITY (defence in depth):
#   1. UI   — mock checkout button only visible when server config returns
#             mockEnabled=true; Razorpay button is hidden simultaneously.
#   2. Gate — beginMockPaymentFn / confirmMockPaymentFn (createServerFn) run
#             on the Node.js server and reject calls when this variable is
#             not set, blocking direct API calls that bypass the UI.
#   3. Auth — the caller's Supabase JWT is forwarded to the RPC; auth.uid()
#             rejects unauthenticated or expired token calls.
#   4. DB   — SECURITY DEFINER RPCs mark every record is_mock=true so
#             production billing reports can identify and filter mock data.
#
# NEVER:
#   • Collect real card numbers, CVV, UPI credentials, or banking passwords
#     while mock mode is active — the mock gateway does not ask for them.
#   • Leave VITE_MOCK_PAYMENTS=true in Vercel Production permanently.
#   • Set RAZORPAY_KEY_SECRET or RAZORPAY_WEBHOOK_SECRET with VITE_ prefix.
#
# ─────────────────────────────────────────────────────────────────────────────
# ENVIRONMENT GUIDE
# ─────────────────────────────────────────────────────────────────────────────
#
# LOCAL DEVELOPMENT
#   1. Copy this file:  cp .env.example .env.local
#   2. Set value:       VITE_MOCK_PAYMENTS=true
#   3. Apply DB schema: (already applied to production — skip for local dev)
#   4. Start server:    npm run dev
#   5. Open:            http://localhost:3000/pricing → choose a paid plan
#   6. The checkout shows an amber banner + "Pay … · Mock Mode" button.
#   7. Click "Simulate Successful Payment" → subscription activates.
#   8. Check /settings?section=billing — invoice labeled MOCK / TEST MODE.
#
# VERCEL PREVIEW (staging branch)
#   1. Vercel Dashboard → Project → Settings → Environment Variables
#   2. Add:   Name = VITE_MOCK_PAYMENTS   Value = true
#   3. Under "Environment" check: ✓ Preview  (do NOT check Production)
#   4. Click Save.  Takes effect on the NEXT request — no redeploy needed.
#   5. Testers visit the Preview URL → mock checkout is visible.
#   6. To disable: delete the variable → takes effect immediately.
#
# VERCEL PRODUCTION (temporary authorized testing with specific testers)
#   PREREQUISITE — Before enabling, verify ALL of these in the Supabase DB:
#     ✓ begin_mock_subscription RPC deployed   (migration 20261106160000+)
#     ✓ confirm_mock_subscription RPC deployed  (migration 20261106210000+)
#     ✓ billing_provider_prices seeded for mock provider (all 6 plan rows)
#     ✓ billing_provider_plan_instances seeded  (all 6 instance rows)
#     ✓ billing_invoices table exists with is_mock column
#     ✓ membership_credit_grants CHECK allows status='completed'
#     ✓ user_subscriptions_one_live_per_user_idx partial unique index exists
#
#   ENABLE:
#   1. Vercel Dashboard → Project → Settings → Environment Variables
#   2. Add:   Name = VITE_MOCK_PAYMENTS   Value = true
#   3. Under "Environment" check: ✓ Production  (and Preview if desired)
#   4. Click Save.  Takes effect on the NEXT page load — no rebuild needed.
#   5. Share the production URL with authorized testers only.
#   6. The checkout shows "TEST MODE — NO REAL PAYMENTS" banner throughout.
#
#   DISABLE (when testing is complete):
#   1. Vercel Dashboard → Project → Settings → Environment Variables
#   2. Find VITE_MOCK_PAYMENTS and DELETE it (or set value to empty string).
#   3. Click Save.  Takes effect immediately — Razorpay checkout restores.
#      (Or, if VITE_RAZORPAY_KEY_ID is not yet configured, the page shows
#       "Payment temporarily unavailable" until Razorpay is set up.)
#
#   WHAT HAPPENS TO MOCK DATA AFTER TESTING:
#   • Mock subscriptions remain in user_subscriptions with is_mock=true
#     and status=active. Testers keep their mock membership until it expires.
#   • To remove a tester's mock subscription after testing ends, run:
#       UPDATE public.user_subscriptions
#       SET status = 'cancelled', cancelled_at = NOW()
#       WHERE provider_name = 'mock' AND user_id = '<tester-user-id>';
#   • Credits granted remain in the wallet. To reset:
#       UPDATE public.user_progression SET credits = 0
#       WHERE user_id = '<tester-user-id>';
# ─────────────────────────────────────────────────────────────────────────────
VITE_MOCK_PAYMENTS=
