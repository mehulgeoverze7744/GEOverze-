# Supabase project connection (public/browser-safe values only).
# Copy this file to .env.local and fill in real values for local development.
# This must point at the SAME Supabase project as geoverze-main.
# Never commit .env, .env.local, .env.production, or any file containing a
# service-role key, database password, or other secret.

# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Publishable / anon key. This key is safe to expose to the browser by design
# (Row Level Security is what actually protects data) — it is NOT the
# service-role key and must never be confused with it. Admin access itself is
# still gated by the authenticated user's role in public.user_roles, verified
# via the public.is_admin() database function — not by this key.
VITE_SUPABASE_ANON_KEY=
