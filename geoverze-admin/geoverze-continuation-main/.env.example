# Supabase project connection (public/browser-safe values only).
# Copy this file to .env.local and fill in real values for local development.
# This must point at the SAME Supabase project as geoverze-main.
# Never commit .env, .env.local, .env.production, or any file containing a
# service-role key, database password, or other secret.

# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Publishable / anon key. This key is safe to expose to the browser by design
# (Row Level Security is what actually protects data) — it is NOT the
# service-role key and must never be confused with it. Admin access itself is
# still gated by the authenticated user's role in public.user_roles, verified
# via the public.is_admin() database function — not by this key.
VITE_SUPABASE_ANON_KEY=

# Optional alias used by newer Supabase projects. If set, it is used when
# VITE_SUPABASE_ANON_KEY is empty. Never put the secret/service-role key here.
# VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional. Site URL used for auth redirects (password reset). Defaults to the
# current browser origin. Set this in production to the Admin domain.
# VITE_ADMIN_SITE_URL=https://admin.example.com
#
# Vercel: add the same VITE_* variables in Project Settings → Environment Variables
# for Production and Preview (they must be present at build time for the browser bundle
# and at serverless runtime for SSR). Redeploy after changing them.
#
# Production checklist (Supabase Dashboard, not committed here):
# - Authentication > URL Configuration > add the Admin origin to Site URL / Redirect URLs
#   e.g. https://admin.example.com/** and https://admin.example.com/reset-password
# - Authentication > URL Configuration > keep the public app origin as well
# - CORS / allowed origins must include both the Admin domain and the public app domain
# - Never set a service-role key in any VITE_ variable
